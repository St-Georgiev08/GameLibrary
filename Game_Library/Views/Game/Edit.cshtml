@model Game_Library.ViewModels.Game.GameEditViewModel

@{
    ViewData["Title"] = "Edit Game";
}

<h1>Edit Game</h1>

<h4>Game</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReleaseYear" class="control-label"></label>
                <input asp-for="ReleaseYear" class="form-control" />
                <span asp-validation-for="ReleaseYear" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Genre" class="control-label"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DeveloperId" class="control-label">
                    Hospital
                </label>

                <select asp-for="DeveloperId"
                        asp-items="ViewBag.Hospitals"
                        class="form-control">
                </select>

                <span asp-validation-for="DeveloperId"
                      class="text-danger">
                </span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>


        <div class="form-group">
            <label asp-for="DeveloperId" class="control-label">
                Developer
            </label>

            <select asp-for="DeveloperId"
                    asp-items="ViewBag.Developers"
                    class="form-control">
                <option value="">Select a developer</option>
            </select>

            <span asp-validation-for="DeveloperId"
                  class="text-danger"></span>
        </div>


        <div class="form-group mt-3">
            <label class="control-label fw-bold">
                Available Platforms
            </label>

            <div class="border rounded p-3 mt-2">
                @foreach (var platform in Model.AvailablePlatforms)
                {
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               name="SelectedPlatformIds"
                               value="@platform.Value"
                               id="platform_@platform.Value"
                               checked="@Model.SelectedPlatformIds.Contains(int.Parse(platform.Value))" />

                        <label class="form-check-label"
                               for="platform_@platform.Value">
                            @platform.Text
                        </label>
                    </div>
                }
            </div>

            <span asp-validation-for="SelectedPlatformIds"
                  class="text-danger"></span>
        </div>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
