@model IEnumerable<Game_Library.ViewModels.Platform.IndexPlatformViewModel>

@{
    ViewData["Title"] = "Platforms";
}

<h2>Platforms</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Platform
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Manufacturer</th>
            <th>Release Year</th>
            <th>Games</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var platform in Model)
        {
            <tr>
                <td>@platform.Name</td>
                <td>@platform.Manufacturer</td>
                <td>@platform.ReleaseYear</td>
                <td>@platform.GamesCount</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@platform.PlatformId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@platform.PlatformId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@platform.PlatformId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
