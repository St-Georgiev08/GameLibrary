@model Game_Library.ViewModels.Platform.EditPlatformViewModel

@{
    ViewData["Title"] = "Edit Platform";
}

<h2>Edit Platform</h2>

<form asp-action="Edit"
      asp-route-id="@Model.PlatformId"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PlatformId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Manufacturer" class="form-label"></label>
        <input asp-for="Manufacturer" class="form-control" />
        <span asp-validation-for="Manufacturer"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReleaseYear" class="form-label"></label>
        <input asp-for="ReleaseYear"
               type="number"
               class="form-control" />
        <span asp-validation-for="ReleaseYear"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
