@model Game_Library.ViewModels.Platform.DeletePlatformViewModel

@{
    ViewData["Title"] = "Delete Platform";
}

<h2>Delete Platform</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this platform?
</div>

<div class="card mb-3">
    <div class="card-body">
        <h4>@Model.Name</h4>

        <p>
            <strong>Manufacturer:</strong>
            @Model.Manufacturer
        </p>

        <p>
            <strong>Release Year:</strong>
            @Model.ReleaseYear
        </p>

        <p>
            <strong>Associated Games:</strong>
            @Model.GamesCount
        </p>
    </div>
</div>

<p class="text-muted">
    Deleting this platform will remove its game
    associations, but the games will not be deleted.
</p>

<form asp-action="Delete"
      asp-route-id="@Model.PlatformId"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
